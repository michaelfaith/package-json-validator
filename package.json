{
  "name": "package-json-validator",
  "version": "1.6.1",
  "description": "Tools to validate package.json files.",
  "keywords": [
    "lint",
    "package.json",
    "package.json linter",
    "package.json validator",
    "validator"
  ],
  "homepage": "https://github.com/michaelfaith/package-json-validator#readme",
  "bugs": {
    "url": "https://github.com/michaelfaith/package-json-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelfaith/package-json-validator.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Nick Sullivan",
      "email": "nick@sullivanflock.com"
    },
    {
      "name": "JoshuaKGoldberg",
      "email": "npm@joshuakgoldberg.com",
      "url": "https://joshuakgoldberg.com"
    },
    {
      "name": "michael faith",
      "email": "michaelfaith@users.noreply.github.com",
      "url": "https://michael.faith"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "type": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "eslint . --max-warnings 0",
    "lint:knip": "knip",
    "prepare": "simple-git-hooks",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "npm-package-arg": "^13.0.2",
    "semver": "^7.7.2",
    "validate-npm-package-license": "^3.0.4",
    "validate-npm-package-name": "^7.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@types/node": "24.13.6",
    "@types/npm-package-arg": "6.1.4",
    "@types/semver": "7.8.0",
    "@types/validate-npm-package-license": "3.0.3",
    "@types/validate-npm-package-name": "4.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "console-fail-test": "0.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-package-json": "1.9.0",
    "eslint-plugin-perfectionist": "5.11.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-yml": "3.8.1",
    "jiti": "2.7.0",
    "knip": "6.37.0",
    "oxfmt": "0.70.0",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
